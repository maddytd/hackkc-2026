# Copy to deploy/.env for a temporary free preview from your own computer.
# Keep Docker and the computer running. The URL changes if the tunnel restarts.
SITE_ADDRESS=:80
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1
HTTP_PORT=18080
HTTPS_PORT=18443
LARP_GEMINI_API_KEY=
LARP_GEMINI_MODEL=gemini-3.8-flash
LARP_INVITE_CODE=
LARP_MAX_DAILY_JOBS=20
LARP_JUDGE_MODE=gemini
