LARP_STORAGE_DIR=storage
LARP_CORS_ORIGINS=["http://localhost:5173"]
LARP_JUDGE_MODE=gemini
# Used by the Strands GeminiModel provider; AWS credentials are not needed.
LARP_GEMINI_API_KEY=
# Set a video-capable model available in your account.
LARP_GEMINI_MODEL=gemini-2.5-flash
LARP_MAX_DAILY_JOBS=100
LARP_MAX_UPLOAD_BYTES=12582912
LARP_INVITE_CODE=change-this-before-public-deployment
