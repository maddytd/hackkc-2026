LARP_STORAGE_DIR=storage
LARP_CORS_ORIGINS=["http://localhost:5173"]

# Judging: "aws" for Pegasus + Bedrock accuracy; "gemini" for the legacy judge;
# "demo" for fixed scores. Complete docs/aws-strands-rollout.md before enabling AWS.
LARP_JUDGE_MODE=gemini
# Add clearly labeled fake accounts and scores to the leaderboard on startup.
LARP_DEMO_SEED_SCORES=false
# Get a key from Google AI Studio. Used by the Strands GeminiModel provider.
LARP_GEMINI_API_KEY=
# A video-capable model available on your account (check AI Studio for current names).
LARP_GEMINI_MODEL=gemini-3.8-flash

# Reviewed niche bank is now the default; generation runs offline into drafts.
LARP_QUESTIONS_FILE=content/questions_niche.json

# AWS uses the standard boto3 credential chain (AWS_PROFILE locally, IAM role on AWS).
# These are model IDs, not API keys. Copy IDs or profile IDs from YOUR Bedrock catalog.
LARP_AWS_REGION=us-east-1
LARP_AWS_ACCURACY_MODEL=
LARP_AWS_ACCURACY_FALLBACK_MODEL=
LARP_AWS_VIDEO_MODEL=twelvelabs.pegasus-1-2-v1:0
LARP_AWS_VIDEO_REGION=us-east-1
# Optional second Pegasus model/region. Both fields are needed to enable video failover.
# A Nova/Claude model is not compatible with this Pegasus-specific video adapter.
LARP_AWS_VIDEO_FALLBACK_MODEL=
LARP_AWS_VIDEO_FALLBACK_REGION=
LARP_AWS_QUESTION_MODEL=amazon.nova-micro-v1:0
LARP_MAX_AI_CALLS_PER_ATTEMPT=6
LARP_PROVIDER_COOLDOWN_SECONDS=60

# Lets the day-switcher load other days (to test different prompts) even in gemini mode.
# Keep this false for a real public game so everyone is locked to today's prompt.
LARP_ALLOW_DAY_OVERRIDE=false

# Leave blank for open registration — the sign-up screen does not ask for a code.
LARP_INVITE_CODE=

LARP_MAX_DAILY_JOBS=100
LARP_MAX_UPLOAD_BYTES=12582912

# Competition days roll over at local midnight. -5 is US Central daylight time; use 0 for UTC.
LARP_DAY_UTC_OFFSET_HOURS=-5

# Logins allowed per minute from one address (sign-up is not limited).
LARP_LOGIN_ATTEMPTS_PER_MINUTE=60
